# Copy to .env and set a random token for imports through Docker.
DVF_ADMIN_TOKEN=
# Published sales: no local import or cadastre processing in the web application.
# By default: local published snapshot when present, otherwise the public S3 dataset.
# Use DVF_DATASET_URL=local only for the legacy DGFiP importer.
# DVF_DATASET_URL=s3://ddecrulle/DVF_Explorer/curated/current.json
DVF_S3_ENDPOINT=https://minio.lab.sspcloud.fr
# Set true only if objects are actually readable without authentication.
DVF_S3_ANONYMOUS=false
# For private S3, inject AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY and optionally
# AWS_SESSION_TOKEN through your environment or an AWS profile. Never commit them.

# Local cache budget for geographic Parquet partitions (MB).
DVF_CACHE_MB=512
